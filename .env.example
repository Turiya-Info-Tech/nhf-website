# ===========================================
# NHF Website - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Web3Forms API Key (for contact form)
# Get from: https://web3forms.com/
VITE_WEB3FORMS_KEY=your-web3forms-key-here

# Google Sheets webhook URL (Apps Script Web App URL)
# Deploy your Apps Script as a Web App and paste the /exec URL here
VITE_GOOGLE_SHEETS_WEBHOOK_URL=

# WhatsApp Number (with country code, no + sign)
VITE_WHATSAPP_NUMBER=919876543210

# Deployment (docker-compose.yml)
NHF_DOMAIN=example.org
# TRAEFIK_NETWORK=veena-group_web
